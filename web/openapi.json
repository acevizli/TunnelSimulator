{
  "openapi": "3.1.0",
  "info": {
    "title": "Tunnel Simulator",
    "version": "0.1.0"
  },
  "paths": {
    "/api/scenarios": {
      "get": {
        "summary": "List Scenarios",
        "operationId": "list_scenarios_api_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Scenario"
                  },
                  "type": "array",
                  "title": "Response List Scenarios Api Scenarios Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Create Run",
        "operationId": "create_run_api_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scenario"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeInside": {
        "properties": {
          "speed_kmh": {
            "type": "number",
            "title": "Speed Kmh",
            "default": 70
          },
          "wobble_kmh": {
            "type": "number",
            "minimum": 0.0,
            "title": "Wobble Kmh",
            "description": "Size of the slow random speed variation",
            "default": 2
          },
          "kind": {
            "type": "string",
            "const": "change_inside",
            "title": "Kind",
            "default": "change_inside"
          },
          "new_speed_kmh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "New Speed Kmh",
            "default": 100
          },
          "change_at_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Change At Fraction",
            "default": 0.3
          }
        },
        "type": "object",
        "title": "ChangeInside",
        "description": "Steady speed up to the tunnel, then a different steady speed inside it."
      },
      "CleanGps": {
        "properties": {
          "noise_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Noise M",
            "description": "Horizontal position noise, 1 sigma",
            "default": 3.0
          },
          "speed_noise_mps": {
            "type": "number",
            "minimum": 0.0,
            "title": "Speed Noise Mps",
            "default": 0.2
          }
        },
        "type": "object",
        "title": "CleanGps",
        "description": "GPS that works normally in the open and is simply absent in tunnels."
      },
      "EstimateTrack": {
        "properties": {
          "estimator": {
            "type": "string",
            "title": "Estimator"
          },
          "path": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Path"
          },
          "s_m": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "S M"
          },
          "v_mps": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "V Mps"
          },
          "sigma_m": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Sigma M"
          },
          "error_m": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Error M"
          }
        },
        "type": "object",
        "required": [
          "estimator",
          "path",
          "s_m",
          "v_mps",
          "sigma_m",
          "error_m"
        ],
        "title": "EstimateTrack"
      },
      "Exit": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "at_m": {
            "type": "number",
            "title": "At M"
          },
          "branch": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "title": "Branch"
          }
        },
        "type": "object",
        "required": [
          "name",
          "at_m",
          "branch"
        ],
        "title": "Exit"
      },
      "ExitMark": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "at_m": {
            "type": "number",
            "title": "At M"
          },
          "planned": {
            "type": "boolean",
            "title": "Planned"
          }
        },
        "type": "object",
        "required": [
          "name",
          "at_m",
          "planned"
        ],
        "title": "ExitMark"
      },
      "ForkRoad": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "fork",
            "title": "Kind",
            "default": "fork"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "Based on the Opera Tunnel, Oslo (5.8 km, a dip, an open-air gap, a fork)"
          },
          "dip_grade_pct": {
            "type": "number",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Dip Grade Pct",
            "default": 4
          },
          "gap_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Gap M",
            "description": "Open-air gap length; 0 removes it",
            "default": 100
          }
        },
        "type": "object",
        "title": "ForkRoad",
        "description": "A dip, a short open-air gap where GPS briefly returns, then the road forks."
      },
      "FreeFlow": {
        "properties": {
          "speed_kmh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Speed Kmh",
            "description": "Cruising speed before the tunnel",
            "default": 80
          },
          "wobble_kmh": {
            "type": "number",
            "minimum": 0.0,
            "title": "Wobble Kmh",
            "description": "Size of the slow random speed variation",
            "default": 2
          },
          "kind": {
            "type": "string",
            "const": "free_flow",
            "title": "Kind",
            "default": "free_flow"
          }
        },
        "type": "object",
        "title": "FreeFlow"
      },
      "FullStop": {
        "properties": {
          "speed_kmh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Speed Kmh",
            "description": "Cruising speed before the tunnel",
            "default": 80
          },
          "wobble_kmh": {
            "type": "number",
            "minimum": 0.0,
            "title": "Wobble Kmh",
            "description": "Size of the slow random speed variation",
            "default": 2
          },
          "kind": {
            "type": "string",
            "const": "full_stop",
            "title": "Kind",
            "default": "full_stop"
          },
          "stop_at_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Stop At Fraction",
            "description": "Where in the tunnel, 0 = entrance, 1 = exit",
            "default": 0.5
          },
          "stop_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Stop S",
            "default": 60
          }
        },
        "type": "object",
        "title": "FullStop",
        "description": "One long stop inside the tunnel, e.g. behind a breakdown."
      },
      "GpsPoint": {
        "properties": {
          "t_s": {
            "type": "number",
            "title": "T S"
          },
          "s_m": {
            "type": "number",
            "title": "S M"
          }
        },
        "type": "object",
        "required": [
          "t_s",
          "s_m"
        ],
        "title": "GpsPoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LongGradeRoad": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "long_grade",
            "title": "Kind",
            "default": "long_grade"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "Based on S\u00f6dra l\u00e4nken, Stockholm (4.5 km, 5% grades, exits underground)"
          },
          "tunnel_length_m": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": 2000.0,
            "title": "Tunnel Length M",
            "default": 4500
          },
          "grade_pct": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Grade Pct",
            "default": 5
          },
          "exit_at_m": {
            "type": "number",
            "title": "Exit At M",
            "description": "Exit position from the tunnel entrance",
            "default": 2700
          }
        },
        "type": "object",
        "title": "LongGradeRoad",
        "description": "A long descent and climb with gentle curves and one exit partway in."
      },
      "OpenRoad": {
        "properties": {
          "before_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "Before S",
            "description": "Seconds of driving before the tunnel",
            "default": 90
          },
          "after_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "After M",
            "default": 1000
          }
        },
        "type": "object",
        "title": "OpenRoad",
        "description": "Driving with good GPS before and after the tunnel."
      },
      "Road": {
        "properties": {
          "main": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "title": "Main"
          },
          "exits": {
            "items": {
              "$ref": "#/components/schemas/Exit"
            },
            "type": "array",
            "title": "Exits",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "main"
        ],
        "title": "Road"
      },
      "Route": {
        "properties": {
          "planned_exit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned Exit",
            "description": "None = stay on the main road"
          },
          "missed_exit": {
            "type": "boolean",
            "title": "Missed Exit",
            "description": "The car drives past the planned exit",
            "default": false
          }
        },
        "type": "object",
        "title": "Route",
        "description": "Which exit the driver is meant to take, and whether they actually do."
      },
      "Run": {
        "properties": {
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "road": {
            "$ref": "#/components/schemas/Road"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "path_length_m": {
            "type": "number",
            "title": "Path Length M"
          },
          "tunnels": {
            "items": {
              "$ref": "#/components/schemas/Span"
            },
            "type": "array",
            "title": "Tunnels"
          },
          "exits": {
            "items": {
              "$ref": "#/components/schemas/ExitMark"
            },
            "type": "array",
            "title": "Exits"
          },
          "t_s": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "T S"
          },
          "truth_s_m": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Truth S M"
          },
          "truth_v_mps": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Truth V Mps"
          },
          "gps": {
            "items": {
              "$ref": "#/components/schemas/GpsPoint"
            },
            "type": "array",
            "title": "Gps"
          },
          "estimates": {
            "items": {
              "$ref": "#/components/schemas/EstimateTrack"
            },
            "type": "array",
            "title": "Estimates"
          }
        },
        "type": "object",
        "required": [
          "scenario",
          "road",
          "path",
          "path_length_m",
          "tunnels",
          "exits",
          "t_s",
          "truth_s_m",
          "truth_v_mps",
          "gps",
          "estimates"
        ],
        "title": "Run"
      },
      "Scenario": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "road": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/StraightRoad"
              },
              {
                "$ref": "#/components/schemas/LongGradeRoad"
              },
              {
                "$ref": "#/components/schemas/TwoExitsRoad"
              },
              {
                "$ref": "#/components/schemas/ForkRoad"
              },
              {
                "$ref": "#/components/schemas/SpiralRoad"
              }
            ],
            "title": "Road",
            "default": {
              "kind": "straight",
              "description": "Based on the Fort McHenry Tunnel (straight, flat, 2.2 km)",
              "tunnel_length_m": 2000.0
            },
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "fork": "#/components/schemas/ForkRoad",
                "long_grade": "#/components/schemas/LongGradeRoad",
                "spiral": "#/components/schemas/SpiralRoad",
                "straight": "#/components/schemas/StraightRoad",
                "two_exits": "#/components/schemas/TwoExitsRoad"
              }
            }
          },
          "open_road": {
            "$ref": "#/components/schemas/OpenRoad",
            "default": {
              "before_s": 90.0,
              "after_m": 1000.0
            }
          },
          "speed": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FreeFlow"
              },
              {
                "$ref": "#/components/schemas/SlowdownAtEntry"
              },
              {
                "$ref": "#/components/schemas/StopAndGo"
              },
              {
                "$ref": "#/components/schemas/FullStop"
              },
              {
                "$ref": "#/components/schemas/ChangeInside"
              }
            ],
            "title": "Speed",
            "default": {
              "speed_kmh": 80.0,
              "wobble_kmh": 2.0,
              "kind": "free_flow"
            },
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "change_inside": "#/components/schemas/ChangeInside",
                "free_flow": "#/components/schemas/FreeFlow",
                "full_stop": "#/components/schemas/FullStop",
                "slowdown_at_entry": "#/components/schemas/SlowdownAtEntry",
                "stop_and_go": "#/components/schemas/StopAndGo"
              }
            }
          },
          "route": {
            "$ref": "#/components/schemas/Route",
            "default": {
              "missed_exit": false
            }
          },
          "gps": {
            "$ref": "#/components/schemas/CleanGps",
            "default": {
              "noise_m": 3.0,
              "speed_noise_mps": 0.2
            }
          }
        },
        "type": "object",
        "required": [
          "name",
          "seed"
        ],
        "title": "Scenario"
      },
      "Segment": {
        "properties": {
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Length M"
          },
          "radius_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Radius M",
            "description": "None = straight; positive turns left, negative turns right"
          },
          "grade_pct": {
            "type": "number",
            "title": "Grade Pct",
            "description": "Climb in % (metres up per 100 m along); negative is downhill",
            "default": 0
          },
          "tunnel": {
            "type": "boolean",
            "title": "Tunnel",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "length_m"
        ],
        "title": "Segment"
      },
      "SlowdownAtEntry": {
        "properties": {
          "speed_kmh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Speed Kmh",
            "description": "Cruising speed before the tunnel",
            "default": 80
          },
          "wobble_kmh": {
            "type": "number",
            "minimum": 0.0,
            "title": "Wobble Kmh",
            "description": "Size of the slow random speed variation",
            "default": 2
          },
          "kind": {
            "type": "string",
            "const": "slowdown_at_entry",
            "title": "Kind",
            "default": "slowdown_at_entry"
          },
          "slow_kmh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Slow Kmh",
            "default": 40
          },
          "starts_before_m": {
            "type": "number",
            "title": "Starts Before M",
            "description": "Slowdown begins this far before the entrance",
            "default": 200
          },
          "lasts_m": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Lasts M",
            "default": 700
          }
        },
        "type": "object",
        "title": "SlowdownAtEntry",
        "description": "Traffic bunches up at the entrance, then clears."
      },
      "Span": {
        "properties": {
          "start_m": {
            "type": "number",
            "title": "Start M"
          },
          "end_m": {
            "type": "number",
            "title": "End M"
          }
        },
        "type": "object",
        "required": [
          "start_m",
          "end_m"
        ],
        "title": "Span"
      },
      "SpiralRoad": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "spiral",
            "title": "Kind",
            "default": "spiral"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "Based on the Spiralen tunnel, Drammen (1.65 km, ~35 m radius, ~10% grade)"
          },
          "radius_m": {
            "type": "number",
            "maximum": 200.0,
            "minimum": 20.0,
            "title": "Radius M",
            "default": 35
          },
          "grade_pct": {
            "type": "number",
            "maximum": 12.0,
            "minimum": 0.0,
            "title": "Grade Pct",
            "default": 10
          }
        },
        "type": "object",
        "title": "SpiralRoad",
        "description": "A tight climbing spiral: extreme, but the most for curve and grade checks to work with."
      },
      "StopAndGo": {
        "properties": {
          "speed_kmh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Speed Kmh",
            "description": "Cruising speed before the tunnel",
            "default": 80
          },
          "wobble_kmh": {
            "type": "number",
            "minimum": 0.0,
            "title": "Wobble Kmh",
            "description": "Size of the slow random speed variation",
            "default": 2
          },
          "kind": {
            "type": "string",
            "const": "stop_and_go",
            "title": "Kind",
            "default": "stop_and_go"
          },
          "go_kmh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Go Kmh",
            "default": 30
          },
          "go_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Go S",
            "default": 20
          },
          "stop_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "Stop S",
            "default": 10
          }
        },
        "type": "object",
        "title": "StopAndGo",
        "description": "Inside the tunnel: drive a little, stop, drive a little, stop..."
      },
      "StraightRoad": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "straight",
            "title": "Kind",
            "default": "straight"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "Based on the Fort McHenry Tunnel (straight, flat, 2.2 km)"
          },
          "tunnel_length_m": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": 500.0,
            "title": "Tunnel Length M",
            "default": 2000
          }
        },
        "type": "object",
        "title": "StraightRoad",
        "description": "Flat and straight: the control case, and the case with no landmarks at all."
      },
      "TwoExitsRoad": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "two_exits",
            "title": "Kind",
            "default": "two_exits"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": "Based on the I-93 O'Neill Tunnel, Boston (2.4 km, exits inside)"
          },
          "tunnel_length_m": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": 1500.0,
            "title": "Tunnel Length M",
            "default": 2400
          },
          "exit_a_at_m": {
            "type": "number",
            "title": "Exit A At M",
            "default": 1200
          },
          "exit_b_at_m": {
            "type": "number",
            "title": "Exit B At M",
            "default": 1600
          }
        },
        "type": "object",
        "title": "TwoExitsRoad",
        "description": "Two exits close together: is the callout for the right one at the right time?"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
