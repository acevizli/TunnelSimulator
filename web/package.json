{
  "name": "tunnelsim-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "gen:api": "cd .. && ~/Library/Python/3.8/bin/uv run python -m tunnelsim_server.dump_openapi > web/openapi.json && cd web && openapi-typescript openapi.json -o src/api-types.ts"
  },
  "dependencies": {
    "plotly.js-dist-min": "2.35.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/plotly.js-dist-min": "2.3.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "openapi-typescript": "7.4.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
